<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Eventos</title>
</head>
<body>
  <h1>Eventos</h1>
  <ul id="lista"></ul>

  <script>
	async function load() {
	  const res = await fetch('/api/evento');
	  const data = await res.json();
	  const ul = document.getElementById('lista');
	  ul.innerHTML = '';
	  data.forEach(e => {
		const li = document.createElement('li');
		li.textContent = `${e.id} - ${e.nombre} - ${new Date(e.fecha).toLocaleDateString()}`;
		ul.appendChild(li);
	  });
	}
	load();
  </script>
</body>
</html>
